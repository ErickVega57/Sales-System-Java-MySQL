<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="405.0" prefWidth="306.0"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.borghisales.salessysten.controllers.MainController">

    <VBox alignment="CENTER" spacing="20.0" prefWidth="350.0" prefHeight="450.0"
          xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml">

        <ImageView fitHeight="71.0" fitWidth="73.0"
                   pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../../images/img.png"/>
            </image>
        </ImageView>

        <Label alignment="CENTER"
               prefHeight="45.0" prefWidth="300.0"
               text="SISTEMA DE VENTAS" underline="true">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <Label alignment="CENTER"
               prefHeight="45.0" prefWidth="170.0"
               text="USUARIO" textAlignment="CENTER" wrapText="true">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <TextField fx:id="user" prefWidth="200.0"/>

        <Label alignment="CENTER"
               prefHeight="45.0" prefWidth="200.0"
               text="CONTRASEÑA">
            <font>
                <Font size="28.0"/>
            </font>
        </Label>

        <PasswordField fx:id="password" prefWidth="200.0"/>

        <Button mnemonicParsing="false"
                onAction="#signIn"
                prefHeight="33.0" prefWidth="150.0"
                text="INICIAR SESION"/>

    </VBox>


</AnchorPane>
